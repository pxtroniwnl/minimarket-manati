# Copia este archivo como .env y completa. Nunca subas .env al repositorio.

# --- Base de datos ---
# Local sin Docker: sqlite:///./dev.db   ·   Producción: Postgres de Neon/Supabase
DATABASE_URL=sqlite:///./dev.db
# Ejemplo Neon: postgresql+psycopg://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- WhatsApp ---
# mock = simulador en /simulador (no envía nada) · cloud = WhatsApp real con Meta
# twilio = Sandbox de Twilio (prueba rápida sin número propio; ~100 mensajes gratis)
WHATSAPP_MODE=mock
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_GRAPH_VERSION=v26.0
# --- Twilio (solo con WHATSAPP_MODE=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=whatsapp:+14155238886
# URL pública para validar la firma de Twilio (en Render se toma sola de RENDER_EXTERNAL_URL)
PUBLIC_URL=

# Meta regala 1.000 mensajes de servicio por número al mes (desde el 1 de octubre de 2026)
WA_FREE_TIER=1000
# Avisos opcionales al cliente (cada uno es un mensaje más por pedido)
NOTIFY_PREPARING=false
NOTIFY_DELIVERED=false

# --- LLM opcional (apagado por defecto) ---
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Panel ---
# Genera valores con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PANEL_PASSWORD=cambiame
SECRET_KEY=dev-secret-cambiame

# --- Tienda ---
STORE_NAME=Minimarket Manatí
OPEN_HOUR=7
CLOSE_HOUR=22
TZ=America/Bogota
# Torres:pisos del conjunto Manatí (T1–3 con 7 pisos, T4–10 con 11) y aptos por piso
TOWERS_LAYOUT=1-3:7,4-10:11
APTS_PER_FLOOR=4

# --- Ajustes finos (opcionales) ---
DRAFT_TTL_MINUTES=120
COURTESY_WINDOW_MINUTES=180
RATE_LIMIT_PER_MINUTE=15
RETENTION_DAYS=90
